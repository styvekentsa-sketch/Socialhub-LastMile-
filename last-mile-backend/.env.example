PORT=3000
NODE_ENV=production
TRUST_PROXY=1
DATABASE_URL=mysql://app_user:strong_password@db.example.internal:3306/e-commerce
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME=e-commerce
DB_CONNECTION_LIMIT=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
GPS_MAX_ACCURACY_METERS=100
JWT_SECRET=
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
FLW_API_URL=https://api.flutterwave.com/v3
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Hors production uniquement : simule les paiements quand Flutterwave n'est pas configure. Mettre false pour desactiver.
FLW_LOCAL_FALLBACK=false

# Publication automatique sur une chaine WhatsApp (@newsletter).
# Si false, le service journalise seulement le message qu'il aurait envoye, sans appel HTTP.
WHATSAPP_CHANNEL_ENABLED=false
WHATSAPP_CHANNEL_PROVIDER=whapi
WHATSAPP_CHANNEL_API_URL=https://gate.whapi.cloud
WHATSAPP_CHANNEL_API_TOKEN=
WHATSAPP_CHANNEL_ID=120363000000000000@newsletter
# Cles publiees, separees par des virgules : order.created, payment.confirmed,
# order.assigned, order.picking, order.picked_up, order.in_transit, order.delivered, order.failed, order.cancelled
WHATSAPP_CHANNEL_EVENTS=order.created,order.delivered,payment.confirmed
WHATSAPP_CHANNEL_TIMEOUT_MS=5000

# Publication sur un canal Telegram via un bot (le bot doit etre administrateur du canal).
# TELEGRAM_CHAT_ID : @nom_du_canal (public) ou identifiant numerique -100... (prive).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EVENTS=order.created,order.delivered,payment.confirmed
TELEGRAM_TIMEOUT_MS=5000

# SMS de secours vers l'equipe d'exploitation (jamais vers les clients).
# SMS_PROVIDER=http : POST SMS_API_URL avec { from, to: [...], message } et Authorization: Bearer SMS_API_KEY.
SMS_ENABLED=false
SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=LastMile
# Numeros au format international, separes par des virgules : +237690000000,+237670000000
SMS_RECIPIENTS=
SMS_EVENTS=order.failed
SMS_TIMEOUT_MS=5000

# Alertes Facebook Messenger vers un membre de l'equipe d'exploitation (API Graph /me/messages).
# MESSENGER_RECIPIENT_ID : PSID de la personne (elle doit avoir ecrit a la page dans les dernieres 24 h).
MESSENGER_ENABLED=false
MESSENGER_PAGE_TOKEN=
MESSENGER_RECIPIENT_ID=
MESSENGER_GRAPH_VERSION=v23.0
MESSENGER_EVENTS=order.failed,order.cancelled
MESSENGER_TIMEOUT_MS=5000

# Publication sur la page entreprise LinkedIn (API UGC Posts /v2/ugcPosts, permission w_organization_social).
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=urn:li:organization:0000000
LINKEDIN_EVENTS=order.delivered
LINKEDIN_TIMEOUT_MS=5000
